# Supabase (projeto na sua VPS ou Supabase Cloud)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — agentes de análise clínica e geração de relatório
ANTHROPIC_API_KEY=
CLINICAL_AGENT_MODEL=claude-sonnet-5

# Serviço de transcrição self-hosted (Whisper/faster-whisper).
# Sem essa variável, o pipeline usa um provider mock — útil para testar o
# resto do fluxo antes do serviço de STT estar no ar.
WHISPER_SERVICE_URL=

# Serviço do SKB (base de conhecimento clínico do apoio-diagnostico/DignosNeuro),
# exposto como HTTP em cima de evidence.py. Sem essa variável, o agente segue
# funcionando mas sem citar evidência da base oficial.
SKB_SERVICE_URL=
